{
  "compilerOptions": {
    "target": "ES2022",
    /* No DOM, and no Node types either. Compiling `src/domain/**` and
       `src/color/**` a second time with only the Workers globals is the point of
       this project: it turns "the pure core runs unmodified under Workers" from
       a claim into a compile error the moment it stops being true. The Workers
       runtime types arrive via server/worker-configuration.d.ts, which is
       generated by `npx wrangler types` and committed, so that
       @cloudflare/workers-types is not a dependency. */
    "lib": ["ES2022"],
    "types": [],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,

    /* `server/**` imports the pure core with relative paths on purpose (see
       CLAUDE.md), but the core's own internal imports use the alias, so it has
       to resolve here too. TS 7 removed `baseUrl`; paths are relative to this
       file. Keep in sync with tsconfig.json, vite.config.ts and vitest.config.ts. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "server/**/*.ts",
    "server/worker-configuration.d.ts",
    "src/domain/**/*.ts",
    "src/color/**/*.ts",
    "src/shared/**/*.ts"
  ],
  /* The core's own tests are typed by tsconfig.json, which has the DOM libs they
     need for fast-check's reporters and for the fixtures they share with the UI. */
  "exclude": ["src/**/*.test.ts"]
}
