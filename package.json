{
  "name": "colors-game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8788",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "e2e": "playwright test",
    "e2e:backend": "playwright test -c playwright.backend.config.ts",
    "migrate:local": "wrangler d1 migrations apply colors --local",
    "d1:reset": "rm -rf .wrangler/state/v3/d1 && wrangler d1 migrations apply colors --local",
    "migrate:remote": "wrangler d1 migrations apply colors --remote",
    "drill": "node scripts/restore-drill.mjs --dump scripts/backup.fixture.sql --manifest scripts/backup.fixture.manifest.json",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.129.0"
  }
}
